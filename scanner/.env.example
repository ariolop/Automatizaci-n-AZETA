# Configuración del ESCÁNER. Copia este archivo a ".env" y rellena los valores.
# (Este .env es solo para el escáner; las credenciales de AZETA y CS siguen en
#  ../.env y ../cspapeleria/.env respectivamente.)

# --- Historial en Supabase (opcional) ---------------------------------------
# Si dejas esto vacío, la app funciona igual pero NO guarda el historial.
# SUPABASE_URL: la URL del proyecto (Supabase -> Project Settings -> Data API).
# SUPABASE_KEY: usa la key "service_role" (secreta, de servidor). NUNCA la pongas
#               en el navegador ni la subas a GitHub.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=
# Nombre de la tabla (opcional; por defecto "escaneos")
SUPABASE_TABLE=escaneos

# --- Acceso a la app (contraseña básica) ------------------------------------
# Si defines APP_PASSWORD, la app pedirá usuario/contraseña. En local puedes
# dejarlo vacío para que quede abierta.
APP_USER=admin
APP_PASSWORD=
